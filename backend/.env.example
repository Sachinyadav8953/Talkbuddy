# TalkBuddy Environment Configuration
# Copy this file to .env and update values for your environment

# Auth
SECRET_KEY=supersecretkeychangeinproduction1234567890!

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=talkbuddy
DB_URL=postgresql://postgres:root1@localhost:5432/Talkbuddy # Alternative connection string

# AI Models (Local Ollama default)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# Cloud LLM API Configuration (Alternative to Ollama, e.g. Gemini/Groq/HuggingFace)
# LLM_PROVIDER=openai
# LLM_API_KEY=your_api_key_here
#
# Optional overrides (automatically detected for Gemini keys starting with 'AIzaSy' and Groq keys starting with 'gsk_'):
# LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# LLM_MODEL=gemini-1.5-flash
