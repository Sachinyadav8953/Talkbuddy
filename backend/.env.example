# TalkBuddy Environment Configuration
# Copy this file to .env and update values for your environment

# Auth
SECRET_KEY=supersecretkeychangeinproduction1234567890!

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=talkbuddy
# DB_URL=postgresql://postgres:root1@localhost:5432/Talkbuddy # Alternative connection string

# AI Models (Local Ollama default)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# Cloud LLM API Configuration (Alternative to Ollama, e.g. Groq/HuggingFace)
 LLM_PROVIDER=openai 
GROQ_API_KEY=your_groq_api_key_here
 LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
 LLM_MODEL=llama-3.1-8b-instant
